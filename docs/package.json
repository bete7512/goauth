{
  "name": "goauth-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "next start",
    "serve": "next start",
    "sync": "node scripts/sync-content.mjs",
    "postinstall": "npm run sync && fumadocs-mdx",
    "typecheck": "npm run sync && fumadocs-mdx && next typegen && tsc --noEmit",
    "check": "node scripts/check-site.mjs",
    "format": "prettier --write app components lib scripts *.ts *.mjs *.json",
    "check:api": "node scripts/check-api.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "beautiful-mermaid": "^1.1.3",
    "fumadocs-core": "16.10.7",
    "fumadocs-mdx": "15.0.13",
    "fumadocs-ui": "16.10.7",
    "js-yaml": "^5.1.0",
    "lucide-react": "^1.21.0",
    "next": "16.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "remark-directive": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.15",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "mdast-util-to-markdown": "2.1.2"
  }
}
